# ==============================================================================
# WALLPAPERS_8K1 ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME=Wallpapers_8k1
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secure_random_hex_key_in_production_32chars
JWT_SECRET=change_this_to_another_secure_secret_key_for_jwt_auth_signing_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL 15+)
# For local development with Docker:
POSTGRES_USER=w8k1_user
POSTGRES_PASSWORD=w8k1_secure_password
POSTGRES_DB=wallpapers_8k1_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy Connection URL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://w8k1_user:w8k1_secure_password@localhost:5432/wallpapers_8k1_db

# Storage Provider Configuration: 'local' or 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_BASE_URL=http://localhost:8000/storage/uploads

# S3 Compatible Storage (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces)
STORAGE_BUCKET_NAME=wallpapers-8k1-production
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Super Admin Initial Account Seed
SUPERADMIN_EMAIL=admin@wallpapers8k1.com
SUPERADMIN_PASSWORD=AdminSecurePassword123!
SUPERADMIN_NAME="Wallpapers 8K1 Administrator"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Firebase Cloud Messaging (FCM) - Future Stage
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
