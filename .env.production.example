# =====================================================================
# WALLPAPERS_8K1 (W8K1) - PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# Application Identity & Mode
APP_NAME=Wallpapers_8k1
APP_ENV=production
APP_DEBUG=false
PORT=8000
HOST=0.0.0.0

# Cryptographic Keys (GENERATE 64-BYTE SECURE RANDOM STRINGS: `openssl rand -hex 32`)
SECRET_KEY=generate_production_cryptographic_secret_key_here_64_bytes
JWT_SECRET=generate_production_jwt_signing_secret_key_here_64_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL 15+ Production Database
POSTGRES_USER=w8k1_prod_user
POSTGRES_PASSWORD=generate_strong_random_db_password_here
POSTGRES_DB=wallpapers_8k1_prod
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://w8k1_prod_user:generate_strong_random_db_password_here@postgres:5432/wallpapers_8k1_prod

# Database Connection Pool Tuning
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache Service
REDIS_URL=redis://redis:6379/0
ENABLE_CACHE=true

# Storage Engine (Local Volume or S3 Compatible Cloud Storage)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/app/storage/uploads
STORAGE_BASE_URL=https://api.wallpapers8k1.com/storage/uploads

# S3 Configuration (Optional - Required only if STORAGE_PROVIDER=s3)
STORAGE_BUCKET_NAME=w8k1-wallpapers-prod
STORAGE_ENDPOINT_URL=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://admin.wallpapers8k1.com,https://wallpapers8k1.com,http://localhost

# Initial Superadmin Credentials
SUPERADMIN_EMAIL=admin@wallpapers8k1.com
SUPERADMIN_PASSWORD=change_this_master_admin_password_immediately
SUPERADMIN_NAME=Platform Administrator

# Rate Limiting
RATE_LIMIT_PER_MINUTE=240

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
